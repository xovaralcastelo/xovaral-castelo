# ============================================================
# Xô Varal Castelo — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================================

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXX

# Google Maps API (para embeds avançados — opcional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# Supabase (área do cliente + clube de vantagens)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SUPABASE_SERVICE_ROLE_KEY — usado pelo painel /admin para CRUD com bypass de RLS.
# NUNCA expor no client. Sem prefix NEXT_PUBLIC_. Só leia em server actions/server components.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Allowlist de emails com acesso ao /admin (comma-separated, case-insensitive)
ADMIN_EMAILS=admin1@dominio.com,admin2@dominio.com
